{
  "schema": "airon-benchmark-protocol/v1",
  "families": [
    {
      "id": "cooling",
      "capability": {
        "id": "airon.cooling.inspection",
        "version": 1,
        "intended_task": "Classify a synthetic cooling assembly maintenance report; take no physical action",
        "outcomes": [
          "INSPECT",
          "STOP_AND_NOTIFY",
          "CONTINUE",
          "OUT_OF_SCOPE",
          "INSUFFICIENT_INPUT"
        ],
        "applicability": {
          "any_terms": [
            "cooling"
          ],
          "min_inputs_present": 1
        },
        "procedure": {
          "inputs": [
            {
              "name": "hours",
              "kind": "cued",
              "cues": [
                "hours"
              ]
            },
            {
              "name": "vibration",
              "kind": "cued",
              "cues": [
                "vibration"
              ]
            }
          ],
          "text_guards": [
            {
              "any_terms": [
                "compressor"
              ],
              "outcome": "OUT_OF_SCOPE"
            }
          ],
          "numeric_guards": [
            {
              "when": "vibration > 4.5",
              "outcome": "STOP_AND_NOTIFY"
            }
          ],
          "missing_input_outcome": "INSUFFICIENT_INPUT",
          "derive": [],
          "rules": [
            {
              "when": "hours >= 200",
              "outcome": "INSPECT"
            }
          ],
          "default_outcome": "CONTINUE"
        },
        "required": {
          "tenant": "synthetic-plant",
          "min_clearance": "restricted",
          "security_domain": "airon-local"
        },
        "dependencies": {
          "knowledge": {
            "maintenance": "BOUND_BY_NATIVE_PROPOSAL"
          },
          "policy_version": "airon-maintenance-v1",
          "execution_model_sha256": null
        },
        "evidence_refs": [
          "maintenance"
        ],
        "failure_conditions": [
          "Missing or ambiguous readings require an expert"
        ],
        "tests": [],
        "proposed_by": "operator"
      },
      "manual": "Inspect the cooling assembly every 200 operating hours. Record the inspection in the maintenance register. If vibration exceeds 4.5 mm/s, stop the equipment and notify the shift supervisor. Reports outside cooling are NOT_APPLICABLE. Compressor reports are OUT_OF_SCOPE. Missing hours or vibration is INSUFFICIENT_INPUT. Otherwise CONTINUE.",
      "development": [
        {
          "id": "dev-01",
          "text": "cooling hours 199 vibration 4.5",
          "expected": "CONTINUE",
          "counterexample": true
        },
        {
          "id": "dev-02",
          "text": "cooling hours 200 vibration 4.5",
          "expected": "INSPECT",
          "counterexample": true
        },
        {
          "id": "dev-03",
          "text": "cooling hours 201 vibration 4.5",
          "expected": "INSPECT",
          "counterexample": false
        },
        {
          "id": "dev-04",
          "text": "cooling hours 10 vibration 4.6",
          "expected": "STOP_AND_NOTIFY",
          "counterexample": true
        },
        {
          "id": "dev-05",
          "text": "cooling hours 250 vibration 5",
          "expected": "STOP_AND_NOTIFY",
          "counterexample": true
        },
        {
          "id": "dev-06",
          "text": "cooling hours 0 vibration 0",
          "expected": "CONTINUE",
          "counterexample": false
        },
        {
          "id": "dev-07",
          "text": "cooling compressor hours 250 vibration 5",
          "expected": "OUT_OF_SCOPE",
          "counterexample": true
        },
        {
          "id": "dev-08",
          "text": "cooling hours 150",
          "expected": "INSUFFICIENT_INPUT",
          "counterexample": true
        },
        {
          "id": "dev-09",
          "text": "cooling vibration 2",
          "expected": "INSUFFICIENT_INPUT",
          "counterexample": true
        },
        {
          "id": "dev-10",
          "text": "battery hours 250 vibration 5",
          "expected": "NOT_APPLICABLE",
          "counterexample": true
        },
        {
          "id": "dev-11",
          "text": "cooling hours 50 vibration 1",
          "expected": "CONTINUE",
          "counterexample": false
        },
        {
          "id": "dev-12",
          "text": "cooling hours 300 vibration 3",
          "expected": "INSPECT",
          "counterexample": false
        }
      ]
    },
    {
      "id": "inventory",
      "capability": {
        "id": "airon.inventory.classification",
        "version": 1,
        "intended_task": "Classify synthetic inventory reports; take no physical action",
        "outcomes": [
          "REORDER",
          "ENOUGH",
          "OUT_OF_SCOPE",
          "INSUFFICIENT_INPUT"
        ],
        "applicability": {
          "any_terms": [
            "inventory"
          ],
          "min_inputs_present": 1
        },
        "procedure": {
          "inputs": [
            {
              "name": "stock",
              "kind": "cued",
              "cues": [
                "stock"
              ]
            },
            {
              "name": "minimum",
              "kind": "cued",
              "cues": [
                "minimum"
              ]
            }
          ],
          "text_guards": [
            {
              "any_terms": [
                "expired"
              ],
              "outcome": "OUT_OF_SCOPE"
            }
          ],
          "numeric_guards": [],
          "missing_input_outcome": "INSUFFICIENT_INPUT",
          "derive": [],
          "rules": [
            {
              "when": "stock < minimum",
              "outcome": "REORDER"
            }
          ],
          "default_outcome": "ENOUGH"
        },
        "required": {
          "tenant": "synthetic-plant",
          "min_clearance": "restricted",
          "security_domain": "airon-local"
        },
        "dependencies": {
          "knowledge": {
            "inventory": "BOUND_BY_NATIVE_PROPOSAL"
          },
          "policy_version": "airon-maintenance-v1",
          "execution_model_sha256": null
        },
        "evidence_refs": [
          "inventory"
        ],
        "failure_conditions": [
          "Missing or ambiguous readings require an expert"
        ],
        "tests": [],
        "proposed_by": "operator"
      },
      "manual": "For inventory reports, REORDER when stock is below minimum; otherwise ENOUGH. Missing stock or minimum means INSUFFICIENT_INPUT. An expired item is OUT_OF_SCOPE. Other families are NOT_APPLICABLE.",
