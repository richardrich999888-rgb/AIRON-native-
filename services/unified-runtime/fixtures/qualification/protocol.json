    {
      "id": "battery",
      "capability": {
        "id": "airon.battery.classification",
        "version": 1,
        "intended_task": "Classify synthetic battery reports; take no physical action",
        "outcomes": [
          "RECHARGE",
          "READY",
          "OUT_OF_SCOPE",
          "INSUFFICIENT_INPUT",
          "STOP"
        ],
        "applicability": {
