                "temperature"
              ]
            },
            {
              "name": "charge",
              "kind": "cued",
              "cues": [
                "charge"
              ]
            }
          ],
          "text_guards": [
            {
              "any_terms": [
                "damaged"
              ],
              "outcome": "OUT_OF_SCOPE"
            }
          ],
          "numeric_guards": [
            {
              "when": "temperature > 60",
              "outcome": "STOP"
            }
          ],
          "missing_input_outcome": "INSUFFICIENT_INPUT",
          "derive": [],
          "rules": [
            {
              "when": "charge < 20",
              "outcome": "RECHARGE"
            }
          ],
          "default_outcome": "READY"
        },
        "required": {
          "tenant": "synthetic-plant",
          "min_clearance": "restricted",
          "security_domain": "airon-local"
        },
        "dependencies": {
          "knowledge": {
            "battery": "BOUND_BY_NATIVE_PROPOSAL"
          },
          "policy_version": "airon-maintenance-v1",
          "execution_model_sha256": null
        },
        "evidence_refs": [
          "battery"
        ],
        "failure_conditions": [
          "Missing or ambiguous readings require an expert"
        ],
        "tests": [],
        "proposed_by": "operator"
      },
      "manual": "For battery reports, STOP if temperature exceeds 60 Celsius. Otherwise RECHARGE if charge is below 20 percent; otherwise READY. Missing temperature or charge means INSUFFICIENT_INPUT. A damaged battery is OUT_OF_SCOPE. Other families are NOT_APPLICABLE.",
